# Docs recipes — import this from the root Justfile with `import "Justfile-docs"`

# Serve the docs locally on http://localhost:3001 with live-reload.
docs-serve:
	cd docs && mdbook serve --open --port 3001

# Build the docs into docs/book/.
docs-build:
	cd docs && mdbook build

# Check that the docs build cleanly (used in CI).
docs-check:
	cd docs && mdbook build

# Install mdbook (requires cargo).
docs-install:
	cargo install mdbook
